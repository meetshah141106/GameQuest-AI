# ── Optional LLM configuration ──────────────────────────────
# The demo runs in fully deterministic mode without any API key.
# To enable LLM-enhanced diagnosis, uncomment and set ONE provider:

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# LLM_PROVIDER=openai          # openai | anthropic | google
# LLM_MODEL=gpt-4o-mini        # model name (provider-specific)
